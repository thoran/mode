#!/usr/bin/env ruby
# mode

# 20260120
# 0.2.0

# Description: Create a modeful context within which to run sub-commands.

require 'abbrev'

EXIT_COMMANDS = Abbrev.abbrev(['exit', 'quit'])

def command_context
  ARGV[0]
end

def main
  prompt = "#{command_context}> "
  loop do
    print prompt
    input = $stdin.gets&.chomp
    break unless input  # Handle Ctrl-D
    case input
    when *EXIT_COMMANDS.keys; break
    when ''
    else
      cmd = "#{command_context} #{input}"
      system(cmd)
    end
  end
end

main
