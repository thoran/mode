#!/usr/bin/env ruby
# mode

# 20260119
# 0.1.0

# Description: Create a modeful context within which to run sub-commands.

def command_context
  ARGV[0]
end

def main
  prompt = "#{command_context}> "
  loop do
    print prompt
    input = $stdin.gets&.chomp
    break unless input  # Handle Ctrl-D
    case input
    when 'exit', 'quit'; break
    when ''
    else
      cmd = "#{command_context} #{input}"
      system(cmd)
    end
  end
end

main
